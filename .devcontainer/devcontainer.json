{
  "name": "Presentations",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/Presentations",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "codespaces": {
      "repositories": {
        "PerryHighCS/syncdeck-agent-skills": {
          "permissions": { "contents": "write" }
        },
        "PerryHighCS/SyncDeck-Reveal": {
          "permissions": { "contents": "write" }
        }
      }
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  },
  "postCreateCommand": "if [ -f /workspaces/Presentations/vendor/SyncDeck-Reveal/package.json ]; then cd /workspaces/Presentations/vendor/SyncDeck-Reveal && npm install; fi",
  "postStartCommand": "bash /workspaces/Presentations/.devcontainer/post-start.sh"
}
