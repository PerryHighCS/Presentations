{
  "name": "Presentations",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/Presentations",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "PerryHighCS/syncdeck-agent-skills": {
          "permissions": { "contents": "write" }
        },
        "PerryHighCS/SyncDeck-Reveal": {
          "permissions": { "contents": "write" }
        }
      }
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  },
  "onCreateCommand": "python3 -m pip install --user --break-system-packages --no-warn-script-location -r /workspaces/Presentations/.devcontainer/requirements.txt",
  "postCreateCommand": "if [ -f /workspaces/Presentations/vendor/SyncDeck-Reveal/package.json ]; then cd /workspaces/Presentations/vendor/SyncDeck-Reveal && npm install; fi",
  "postStartCommand": "bash /workspaces/Presentations/.devcontainer/post-start.sh"
}
